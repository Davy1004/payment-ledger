# copy to .env (never commit .env)
DATABASE_URL=postgresql+asyncpg://ledger_user:ledger_password@localhost:5432/payment_ledger
SQL_ECHO=false

# Operator key for /api/v1/admin/* and /metrics. Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Unset = admin endpoints answer 503 (fail closed).
ADMIN_API_KEY=change-me

# requests per minute per API client (token bucket); 0 = unlimited
RATE_LIMIT_PER_MINUTE=120

# Outbox -> signed webhooks. Leave WEBHOOK_URL empty to record events without delivering them.
WEBHOOK_URL=
WEBHOOK_SECRET=change-me-too
OUTBOX_MAX_ATTEMPTS=8
LOG_LEVEL=INFO
